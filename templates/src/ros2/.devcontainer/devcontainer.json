{
  "name": "ROS 2",
  "image": "althack/ros2:${templateOption:distro}-${templateOption:imageVariant}",
  "remoteUser": "ros",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp:unconfined",
    "--security-opt=apparmor:unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-python.python",
        "twxs.cmake",
        "redhat.vscode-yaml"
      ]
    }
  }
}
